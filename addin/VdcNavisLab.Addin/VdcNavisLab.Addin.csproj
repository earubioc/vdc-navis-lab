<Project Sdk="Microsoft.NET.Sdk">
  <!-- DRAFT: not compiled yet. See ../README.md. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>VdcNavisLab.Addin</AssemblyName>
    <RootNamespace>VdcNavisLab.Addin</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Override on the command line: dotnet build -p:NavisworksDir="C:\Program Files\Autodesk\Navisworks Manage 2025" -->
